DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Explicit sqlite also works with DJANGO_DEBUG=false; mysql uses MYSQL_* below.
DB_ENGINE=sqlite
# Optional SQLite path, relative to the project root or absolute; default var/dev.sqlite3.
# SQLITE_PATH=var/dev.sqlite3
MYSQL_DATABASE=scholarships
MYSQL_USER=scholarships
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:5173
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_DIR=var/index
# LLM Provider: 'groq' or 'gemini'
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
# If using Gemini instead:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_MAX_OUTPUT_TOKENS=2400
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
TOOL_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_ITERATIONS=6
LLM_MAX_INPUT_CHARS=24000
MYSQL_ROOT_PASSWORD=
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HEADERS=false
SECURE_SSL_REDIRECT=false

# Local semantic classification + bounded retrieved evidence; keep query text private by default.
RAG_CONTEXT_MAX_CHARS=10000
RAG_HISTORY_MAX_CHARS=2000
RAG_LOG_QUERY_TEXT=false
# auto: one generation for simple lookups; review uncertainty/complexity. always: review every answer.
LLM_GROUNDING_REVIEW=auto

# Bounded retries apply only to transient provider failures, including during review.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=5
LLM_RETRY_MAX_SECONDS=20
LLM_TOTAL_TIMEOUT_SECONDS=90

# Backend-only container static serving; enabled in the HF Docker image.
DJANGO_SERVE_STATIC=false

# Keep Linux model files inside the repository cache boundary checked by provisioning.
HF_HUB_DISABLE_SHARED_BLOBS=1
# Production entrypoint defaults; Render supplies PORT, Spaces uses 8000 by default.
# PORT=8000
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=2
