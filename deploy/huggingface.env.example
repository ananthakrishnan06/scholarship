# Copy to ignored .env.hf for local Docker testing; configure the same names in Space Settings.
# Empty deployment-specific values must be supplied privately. Do not commit a filled template.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# Image default is mysql; explicitly set sqlite for a single-instance demo.
DB_ENGINE=mysql
# Optional only for SQLite (default var/dev.sqlite3); persist the containing directory.
# SQLITE_PATH=var/dev.sqlite3
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
# Set the actual provider endpoint port. Standard 3306 is blocked by Spaces networking.
MYSQL_PORT=
# Actual assigned Space host plus localhost,127.0.0.1 for the internal health check.
ALLOWED_HOSTS=
# Exact HTTPS Vercel origin, with no trailing slash.
CORS_ALLOWED_ORIGINS=
# Configure actual HTTPS origins when using browser session/cookie-authenticated POSTs.
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HEADERS=true
SECURE_SSL_REDIRECT=true
DJANGO_SERVE_STATIC=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Existing application default; verify this model is available to your API project.
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_PROVIDER=none
# Omit fallback model/key unless enabling a separately configured fallback.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_DIR=/app/var/index
HF_HOME=/opt/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
RAG_CONTEXT_MAX_CHARS=10000
RAG_HISTORY_MAX_CHARS=2000
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=90
TOOL_TIMEOUT_SECONDS=30
LLM_GROUNDING_REVIEW=auto
RAG_LOG_QUERY_TEXT=false

# Keep repo-local model blobs; shared Hub blobs cross the validation boundary.
HF_HUB_DISABLE_SHARED_BLOBS=1
# Must match README app_port; omit PORT to use the same 8000 default.
PORT=8000
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
