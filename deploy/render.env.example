# Set these variables in the Render Docker web service; never commit filled secrets.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DB_ENGINE=sqlite
ALLOWED_HOSTS=your-service.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Needed for browser cookie/session authenticated POSTs; does not replace CORS.
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
# Trust forwarded HTTPS headers only through Render's restricted ingress.
TRUST_PROXY_HEADERS=true
SECURE_SSL_REDIRECT=true
DJANGO_SERVE_STATIC=true
# Default database: /app/var/dev.sqlite3. Parent directories are created.
# Optional persistent disk: mount /app/var/sqlite and enable the following path.
# SQLITE_PATH=/app/var/sqlite/db.sqlite3
# Render supplies PORT (normally 10000); the entrypoint respects it.
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_PROVIDER=none
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_DIR=/app/var/index
HF_HOME=/opt/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_SHARED_BLOBS=1
RAG_CONTEXT_MAX_CHARS=10000
RAG_HISTORY_MAX_CHARS=2000
RAG_LOG_QUERY_TEXT=false
LLM_GROUNDING_REVIEW=auto
# No MYSQL_* variables are required for SQLite.
# Backend health check path: /health/live; dependency check: /health/ready.
# Frontend Vercel variable: VITE_API_BASE=https://your-service.onrender.com
