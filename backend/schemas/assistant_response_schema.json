{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "scheme_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scheme Id",
          "type": "string"
        },
        "scheme_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Scheme Name",
          "type": "string"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Name"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "retrieved_from": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Retrieved From",
          "type": "string"
        },
        "original_record_key": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Record Key"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 3000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        }
      },
      "required": [
        "scheme_id",
        "scheme_name",
        "retrieved_from"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ErrorItem": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Answer",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "maxItems": 16,
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "enum": [
        "success",
        "out_of_scope",
        "insufficient_evidence",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorItem"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    }
  },
  "required": [
    "answer",
    "sources",
    "status"
  ],
  "title": "ScholarshipAnswer",
  "type": "object"
}
